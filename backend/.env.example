# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (comma-separated origins or * for all in dev)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
SUPABASE_SECRET_KEY=your-supabase-secret-key-here

# Mistral AI Configuration (Planned for upcoming phase)
MISTRAL_API_KEY=your-mistral-api-key-here
